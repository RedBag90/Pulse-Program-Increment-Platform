generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  region    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  // Portfolio Dashboard settings (the "Soll" for the economics view).
  costNeutralTarget   Decimal?  @map("cost_neutral_target") @db.Decimal(14, 2) // self-funding threshold / month
  dashboardHorizonEnd DateTime? @map("dashboard_horizon_end") @db.Date // recurring-benefit accrual end

  // Participatory Budgeting: total budget pool per half-year, e.g. { "2026-H1": 500000 }.
  budgetPoolByPeriod Json? @map("budget_pool_by_period")

  // Conversion rate that turns WSJF Job-Size points into € for the PI-Planning
  // capacity overlay (Σ Job Size × this = €-Demand vs. ART budget). When null,
  // the €-axis of the capacity badge is hidden — Job Size alone is rendered.
  costPerJobSizePoint Decimal? @map("cost_per_job_size_point") @db.Decimal(10, 2)

  // SAFe Portfolio Guardrails (Roadmap-G1). Targets je Achse summieren auf
  // 100 %; Defaults in `src/domain/portfolio-guardrails.ts`.
  guardrailTargets Json? @map("guardrail_targets")

  valueStreams            ValueStream[]
  arts                    Art[]
  teams                   Team[]
  initiatives             Initiative[]
  kpis                    Kpi[]
  epicApprovals           EpicApproval[]
  userRoleAssignments     UserRoleAssignment[]
  jiraConfig              JiraConfig?
  azureDevOpsConfig       AzureDevOpsConfig?
  targetModels            TargetOperatingModel[]
  transformationActions   TransformationAction[]
  strategicThemes         StrategicTheme[]
  objectives              Objective[]
  keyResults              KeyResult[]
  krKpiContributions      KrKpiContribution[]
  themeEpicLinks          ThemeEpicLink[]
  goalEpicLinks           GoalEpicLink[]
  budgetAllocations       BudgetAllocation[]
  artBudgets              ArtBudget[]
  budgetPlanRevisions     BudgetPlanRevision[]
  piStandards             PiStandard[]
  timelines               Timeline[]
  setupProgress           SetupProgress[]

  @@map("tenants")
}

/// Setup-Guide-Fortschritt pro Tenant. Eine Zeile = ein abgehakter Check.
/// Tenant-weit gemeinsam: nur Tenant-Admin (Capability `tenant.users.manage`)
/// darf schreiben; alle eingeloggten User sehen denselben Stand. Reihenfolge
/// + Bedeutung der `checkId` lebt im UI-Code (`src/features/setup/data/milestones.ts`).
model SetupProgress {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  checkId   String   @map("check_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, checkId])
  @@map("setup_progress")
}

/// A reusable, named PI calendar: a uniform cadence × count anchored at a
/// day/month. Applying it to an ART for a given year generates contiguous PIs
/// named "PI 1" … "PI n" (see [pi-standard.ts](src/domain/pi-standard.ts)),
/// adding only those whose date range is free of existing PIs.
model PiStandard {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  anchorMonth  Int      @map("anchor_month") // 1–12
  anchorDay    Int      @map("anchor_day") // 1–31
  cadenceWeeks Int      @map("cadence_weeks") // e.g. 8
  piCount      Int      @map("pi_count") // e.g. 6
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pi_standards")
}

/// The management-defined target operating model — the "Soll" the transformation
/// drives toward. At most one `active` model per tenant (enforced in the
/// service, which archives the prior active on activation). Nullable structure
/// targets and the practice flags express *which* of SAFe the org actually
/// adopts — the flags are the master switch that scopes which concepts appear.
model TargetOperatingModel {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  status     String    @default("draft") // draft | active | archived
  template   String? // team_level | essential_safe | portfolio_safe | custom
  targetDate DateTime? @map("target_date")

  // Structure targets — null = not part of the target.
  targetValueStreams   Int? @map("target_value_streams")
  targetArtsTotal      Int? @map("target_arts_total")
  targetTeamsTotal     Int? @map("target_teams_total")
  targetPiCadenceWeeks Int? @map("target_pi_cadence_weeks")

  // Enabled practices — which parts of the model the org actually runs.
  portfolioLevel     Boolean @default(true) @map("portfolio_level")
  programLevel       Boolean @default(true) @map("program_level")
  stageGates         Boolean @default(true) @map("stage_gates")
  wsjf               Boolean @default(true)
  multiPartyApproval Boolean @default(true) @map("multi_party_approval")
  featureQs          Boolean @default(true) @map("feature_qs")
  dependencies       Boolean @default(true)
  piObjectives       Boolean @default(true) @map("pi_objectives")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("target_operating_models")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Ziele-Modul V2 — Strategic Theme / Objective / KeyResult / KPI-Bindung
//
//  SAFe-Lean-Portfolio-Management-konforme Hierarchie.
//
//  StrategicTheme dient als versteckter Default-Anchor in der flachen
//  2-Ebenen-Hierarchie (Theme = Objective in der UI). Objective → KeyResult
//  (messbar). KeyResult bindet n:m an existierende `Kpi` (am Epic) via
//  `KrKpiContribution` mit Gewicht — damit rollt der €-Effekt von ganz unten
//  (KPI · valuePerUnit · benefitWeight) durchgaengig nach oben.
// ─────────────────────────────────────────────────────────────────────────────

model StrategicTheme {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  title           String
  narrative       String?  @db.Text
  /// Hex-Color fuer Strategy-Map (Tree-Card-Stripe + Sankey-Band-Farbe).
  color           String   @default("#6366f1")
  /// "business" oder "enabler" (Petras Heimat). Treibt Investment-Mix-
  /// Sicht im Money-Tab.
  kind            String   @default("business")
  /// Lean-Budget-Anker in € pro Jahr (Investment-Bucket). Wird als
  /// Vergleichs-Basis fuer ROI in der Money-Sicht verwendet.
  budgetPlanned   Decimal? @map("budget_planned") @db.Decimal(14, 2)
  /// Frei-konfigurierbare Guardrails, JSON (z. B. {minEnablerRatio: 0.2}).
  guardrails      Json?
  ownerId         String?  @map("owner_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  status          String   @default("active") // active | sunsetted | archived
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  objectives Objective[]
  epicLinks  ThemeEpicLink[]

  @@index([tenantId])
  @@map("strategic_themes")
}

model Objective {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  themeId    String   @map("theme_id") @db.Uuid
  title      String
  narrative  String?  @db.Text
  /// Quartal-Slot, ISO-Form „YYYY-Qn" (z. B. „2026-Q2"). Null = Backlog
  /// (noch nicht in einem Quartal eingeplant).
  period     String?
  /// Fist-of-Five-Confidence (1..5). Wird im PI-Planning / Quartal-Sync
  /// gevotet; treibt die ★-Anzeige in den Cards.
  confidence Int?
  ownerId    String?  @map("owner_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  /// Goal-Status (src/domain/goal-status.ts). Null = kein Check-in ("No
  /// recent updates"). Open: on_track | at_risk | off_track. Closed:
  /// achieved | partial | missed | dropped.
  status     String?
  dueDate    DateTime? @map("due_date")
  /// Gesetzt, sobald ein Closed-Status gewaehlt wird.
  closedAt   DateTime? @map("closed_at")
  /// Lessons-Learned-Notiz, gepflegt beim Quartal-Reset-Wizard.
  closingNote String? @map("closing_note") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  theme      StrategicTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  keyResults KeyResult[]
  checkins   GoalCheckin[]
  comments   GoalComment[]
  epicLinks  GoalEpicLink[]

  @@index([tenantId])
  @@index([themeId])
  @@index([period])
  @@map("objectives")
}

model KeyResult {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  objectiveId  String   @map("objective_id") @db.Uuid
  title        String
  metricName   String?  @map("metric_name")
  metricUnit   String?  @map("metric_unit")
  /// Metrik-Typ (src/domain/goal-metric.ts): number | percent | currency.
  /// Bestimmt Formatierung/Achsen; `metricUnit` bleibt das freie Label.
  metricType   String   @default("number") @map("metric_type")
  /// Nachkommastellen 0..6 fuer die Anzeige.
  precision    Int      @default(0)
  /// ISO-4217, nur bei metricType=currency.
  currencyCode String?  @map("currency_code")
  /// Relatives Gewicht im Objective-Rollup (ADR-0008 / Epic 3). Null =
  /// Default 1 ⇒ gleichgewichtet; intern via Σ normalisiert.
  rollupWeight Decimal? @db.Decimal(6, 4) @map("rollup_weight")
  baseline     Decimal? @db.Decimal(14, 4)
  target       Decimal? @db.Decimal(14, 4)
  /// "auto_from_kpi" → `current` wird aus den verlinkten KPIs aggregiert,
  /// `manual` → User pflegt `current` direkt im KR-Editor.
  formula      String   @default("auto_from_kpi")
  current      Decimal? @db.Decimal(14, 4)
  /// Goal-Status (src/domain/goal-status.ts). Null = kein Check-in.
  status       String?
  dueDate      DateTime? @map("due_date")
  ownerId      String?  @map("owner_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String   @map("created_by") @db.Uuid
  updatedBy    String   @map("updated_by") @db.Uuid

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  objective      Objective           @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  kpiContributions KrKpiContribution[]
  checkins       GoalCheckin[]
  comments       GoalComment[]
  epicLinks      GoalEpicLink[]

  @@index([tenantId])
  @@index([objectiveId])
  @@map("key_results")
}

/// Status-/Progress-Check-in an einem Ziel (Objective ODER Key Result) —
/// Asana-artige Historie. Genau eine der beiden FKs ist gesetzt. `status =
/// null` markiert ein reines Progress-Update (kein Status-Event). `value`
/// traegt den rohen KR-Ist-Wert, `progress` den normalisierten 0..1-Snapshot.
/// Backt „Latest status" + Verlaufschart.
model GoalCheckin {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String?  @map("objective_id") @db.Uuid
  keyResultId String?  @map("key_result_id") @db.Uuid
  status      String?
  value       Decimal? @db.Decimal(14, 4)
  progress    Decimal? @db.Decimal(14, 4)
  note        String?  @db.Text
  /// Strukturiertes Status-Update (Epic 4): Array [{title, body}]. Null =
  /// nur `note`/kein Freitext (rückwärtskompatibel).
  sections    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectiveId, createdAt])
  @@index([tenantId, keyResultId, createdAt])
  @@map("goal_checkins")
}

/// Freitext-Kommentar an einem Ziel (Objective ODER Key Result) fuer den
/// Aktivitaets-Feed. Genau eine der beiden FKs ist gesetzt.
model GoalComment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String?  @map("objective_id") @db.Uuid
  keyResultId String?  @map("key_result_id") @db.Uuid
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectiveId, createdAt])
  @@index([tenantId, keyResultId, createdAt])
  @@map("goal_comments")
}

/// Brueckentabelle KeyResult ↔ Epic-Kpi mit Gewicht. Mehrere Epic-KPIs
/// koennen denselben KR bedienen (verteilt ueber `weight`), und ein KPI
/// kann mehrere KRs befuettern (z. B. NPS treibt CX-Theme + Quality-Theme).
model KrKpiContribution {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  keyResultId         String   @map("key_result_id") @db.Uuid
  kpiId               String   @map("kpi_id") @db.Uuid
  weight              Decimal  @default(1) @db.Decimal(6, 4) // 0..1
  /// Optional: ueberschreibt den KPI-eigenen valuePerUnit fuer Sicht
  /// auf diesen KR. Sonst Default = `Kpi.valuePerUnit`.
  valuePerUnitOverride Decimal? @map("value_per_unit_override") @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  createdBy           String   @map("created_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  kpi       Kpi       @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, kpiId])
  /// Pyramid-Invariante: jede KPI feedet hoechstens einen KR (1 Epic → 1 KPI → ≤ 1 KR).
  /// DB-Backstop fuer kpi-binding-invariant + setKpiBinding.
  @@unique([kpiId])
  @@index([tenantId])
  @@map("kr_kpi_contributions")
}

/// Theme ↔ Epic n:m (Theme-direkte Verlinkung ohne KR-Schritt — z. B.
/// fuer Epics die einen Theme-Beitrag liefern, aber keinen messbaren KR).
model ThemeEpicLink {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  themeId   String   @map("theme_id") @db.Uuid
  epicId    String   @map("epic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  theme  StrategicTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  epic   Initiative     @relation(fields: [epicId], references: [id])

  @@unique([themeId, epicId])
  @@index([tenantId])
  @@index([epicId])
  @@map("theme_epic_links")
}

/// Ziel ↔ Epic Direktverknüpfung ("Related work"). Ein Epic wird direkt an
/// ein Ziel (Objective ODER Key Result) gehängt — genau eine der beiden FKs
/// ist gesetzt. Referenziell PLUS wertbringend: der von den Epic-KPIs
/// bestimmte Mehrwert rollt in den Ziel-Trio (goals-rollup epicLinkTrio).
/// `@@unique([epicId])` = Count-once: jedes Epic feedet ≤ 1 Ziel-Knoten;
/// zusammen mit der KPI-Pyramide zählt jeder Euro genau einmal pro Ebene
/// (ADR: epic-goal-link-value-single-path).
model GoalEpicLink {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String?  @map("objective_id") @db.Uuid
  keyResultId String?  @map("key_result_id") @db.Uuid
  epicId      String   @map("epic_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult KeyResult? @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  epic      Initiative @relation(fields: [epicId], references: [id], onDelete: Cascade)

  @@unique([epicId])
  @@index([tenantId, objectiveId])
  @@index([tenantId, keyResultId])
  @@index([epicId])
  @@map("goal_epic_links")
}

/// A tracked transformation action — the "Steuern" backlog that moves the
/// organisation from Ist toward the Soll. Management-owned, tenant-scoped.
model TransformationAction {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  title     String
  status    String    @default("open") // open | in_progress | done
  ownerId   String?   @map("owner_id") @db.Uuid
  dueDate   DateTime? @map("due_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("transformation_actions")
}

/// A daily point-in-time capture of the transformation's headline metrics — the
/// "Reise über Zeit". One row per tenant per day (idempotent upsert), so the
model ValueStream {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  description       String?
  budgetAmount      Decimal?  @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency    String?   @map("budget_currency") @db.Char(3)
  // Governance: who signs off Epics in this value stream (Finance party) and the
  // responsible VMO — loose user ids (users live in Supabase auth).
  financeApproverId String?   @map("finance_approver_id") @db.Uuid
  vmoId             String?   @map("vmo_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  arts   Art[]
  epics  Initiative[] @relation("EpicValueStream")

  // Uniqueness among *active* (non-deleted) rows is enforced by a partial unique
  // index created out-of-band (see prisma/manual-indexes.sql) — Prisma can't
  // express `WHERE deleted_at IS NULL`, so the table-level @@unique is dropped.
  @@map("value_streams")
}

model Art {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  valueStreamId  String    @map("value_stream_id") @db.Uuid
  name           String
  description    String?
  /// Default cadence for new PIs on ARTs not yet subscribed to a Timeline
  /// (legacy fallback). Timelines no longer carry a cadence — each PI defines
  /// its own start/end window.
  piCadenceWeeks Int       @default(10) @map("pi_cadence_weeks")
  rteId          String?   @map("rte_id") @db.Uuid // Release Train Engineer
  /// Subscription to a shared Timeline. Each ART belongs to at most one
  /// Timeline; nullable during the rollout so brand-new ARTs (or those that
  /// left a Timeline) live without one. The PI grid the ART planss against
  /// comes from `timeline.programIncrements`.
  timelineId     String?   @map("timeline_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  valueStream ValueStream        @relation(fields: [valueStreamId], references: [id])
  timeline    Timeline?          @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  pis         ProgramIncrement[]
  features    Initiative[]       @relation("FeatureArt")
  teams       Team[]
  impediments Impediment[]
  budget      ArtBudget?

  // Active-row uniqueness via a partial unique index (see prisma/manual-indexes.sql).
  @@index([timelineId])
  @@map("arts")
}

model Team {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  artId          String  @map("art_id") @db.Uuid
  name           String
  description    String?
  headcount      Int?
  targetVelocity Int?    @map("target_velocity")
  scrumMasterId  String? @map("scrum_master_id") @db.Uuid
  productOwnerId String? @map("product_owner_id") @db.Uuid
  teamType       String? @map("team_type") // stream_aligned | complicated_subsystem | platform | enabling

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  art        Art           @relation(fields: [artId], references: [id])
  objectives PiObjective[]

  @@unique([tenantId, name])
  @@index([artId])
  @@map("teams")
}

model ProgramIncrement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Legacy direct link to ART. Backfilled into `timelineId` during rollout;
  /// kept nullable for transitional safety and dropped in a cleanup PR.
  artId     String?  @map("art_id") @db.Uuid
  /// The PI's owning Timeline. Nullable only during the migration window;
  /// new PIs must always carry a timelineId.
  timelineId String? @map("timeline_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("planned")

  // PI Planning capacity (overrides). When null, the auto-prorated value from
  // the ART budget is used for the €-axis; Job-Size capacity is "unlimited"
  // (no over-allocation flag).
  capacityJobSize Int?     @map("capacity_job_size")
  capacityAmount  Decimal? @map("capacity_amount") @db.Decimal(14, 2)

  // PI-Closure-Metadaten — vom RTE via Closure-Wizard gesetzt; werden vom
  // pre-check in `completePi` zwingend erwartet, bevor das PI auf
  // "completed" gehen darf.
  systemDemoAt        DateTime? @map("system_demo_at") @db.Date
  inspectAdaptAt      DateTime? @map("inspect_adapt_at") @db.Date
  retrospectiveNotes  String?   @map("retrospective_notes") @db.Text
  retrospectiveAt     DateTime? @map("retrospective_at")

  art         Art?          @relation(fields: [artId], references: [id])
  timeline    Timeline?     @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  initiatives Initiative[]
  objectives  PiObjective[]
  impediments Impediment[]
  systemDemo  SystemDemo?

  @@unique([timelineId, name])
  @@index([timelineId])
  @@map("program_increments")
}

/// A shared PI cadence. ARTs subscribe to a Timeline (via `Art.timelineId`)
/// and plan their Features against the Timeline's PIs instead of owning a
/// private PI list. Reduces duplication when multiple ARTs follow the same
/// rhythm; one Timeline → many ARTs → one shared PI grid.
model Timeline {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  arts              Art[]
  programIncrements ProgramIncrement[]

  @@index([tenantId])
  @@map("timelines")
}

model PiObjective {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  piId          String   @map("pi_id") @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  title         String
  description   String?  @db.Text
  businessValue Int?     @map("business_value") // 1-10
  committed     Boolean  @default(true)
  confidence    Int?     @map("confidence") // SAFe fist-of-five vote, 1-5
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String   @map("created_by") @db.Uuid

  pi   ProgramIncrement @relation(fields: [piId], references: [id])
  team Team             @relation(fields: [teamId], references: [id])

  @@index([piId])
  @@index([teamId])
  @@map("pi_objectives")
}

/// System Demo pro PI. Wird beim PI-Closure-Wizard mit Inhalten gefuellt,
/// vom RTE und Feature Ownern gepflegt. Ein PI hat genau einen SystemDemo
/// (Unique-Constraint). Items werden als geordnete Liste gehalten
/// (`position`).
model SystemDemo {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  piId         String    @unique @map("pi_id") @db.Uuid
  scheduledAt  DateTime? @map("scheduled_at")
  recordingUrl String?   @map("recording_url")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by") @db.Uuid

  pi    ProgramIncrement @relation(fields: [piId], references: [id])
  items SystemDemoItem[]

  @@index([tenantId])
  @@map("system_demos")
}

model SystemDemoItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  demoId    String   @map("demo_id") @db.Uuid
  /// Optional: ein Demo-Item kann sich auf ein Feature beziehen
  /// (Owner wird dann typischerweise daraus abgeleitet).
  featureId String?  @map("feature_id") @db.Uuid
  title     String
  ownerId   String?  @map("owner_id") @db.Uuid
  presented Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  demo SystemDemo @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId])
  @@index([featureId])
  @@map("system_demo_items")
}

model Initiative {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  level    Int // 0=EPIC, 1=FEATURE
  parentId String? @map("parent_id") @db.Uuid
  path     String // materialized path

  title       String
  description String?  @db.Text
  ownerId     String?  @map("owner_id") @db.Uuid // null until an owner is nominated (Epics start unassigned)
  assigneeIds String[] @map("assignee_ids") @db.Uuid

  // Level-specific foreign keys
  valueStreamId String? @map("value_stream_id") @db.Uuid // EPIC only
  artId         String? @map("art_id") @db.Uuid // FEATURE only
  piId          String? @map("pi_id") @db.Uuid // FEATURE only

  // WSJF fields (FEATURE only)
  wsjfBusinessValue   Int?     @map("wsjf_business_value")
  wsjfTimeCriticality Int?     @map("wsjf_time_criticality")
  wsjfRiskReduction   Int?     @map("wsjf_risk_reduction")
  wsjfJobSize         Int?     @map("wsjf_job_size")
  wsjfComputed        Decimal? @map("wsjf_computed") @db.Decimal(5, 2)

  // Epic artefacts (EPIC only – stored as versioned JSON)
  benefitHypothesis Json? @map("benefit_hypothesis") // L1 Reviewing
  businessCase      Json? @map("business_case") // L2 Analyzing

  // Snapshot of the last approved revision's artefacts (EPIC only), captured at
  // startRevision — the baseline the side-by-side revision diff compares against.
  baselineBenefitHypothesis Json? @map("baseline_benefit_hypothesis")
  baselineBusinessCase      Json? @map("baseline_business_case")

  // Epic timeline (EPIC only): owner-set estimates + manual actuals (backlog,
  // implementation) as a flat JSON; auto actuals live in the columns below.
  timeline               Json?     @map("timeline")
  selectedForDetailingAt DateTime? @map("selected_for_detailing_at") // stamped when the Epic enters L1
  hypothesisApprovedAt   DateTime? @map("hypothesis_approved_at")
  selectedForAnalyzingAt DateTime? @map("selected_for_analyzing_at") // stamped when the Epic enters L2
  businessCaseApprovedAt DateTime? @map("business_case_approved_at")

  // Geplantes Umsetzungsfenster (EPIC only): the owner-set "Soll" window for
  // when the Epic should be in delivery. Roadmap shows this alongside the
  // derived "Ist" window (the span of its Features' PIs); divergences surface
  // as warnings without blocking scheduling.
  plannedStartAt DateTime? @map("planned_start_at") @db.Date
  plannedEndAt   DateTime? @map("planned_end_at")   @db.Date

  // Acceptance criteria (FEATURE only)
  acceptanceCriteria String[] @map("acceptance_criteria")

  // External system sync (e.g. Jira issue key "PROJ-123")
  externalId     String? @map("external_id")
  externalSystem String? @map("external_system") // "jira" | "ado"

  stageGate String @default("L0") @map("stage_gate")
  status    String @default("draft")

  // Multi-party approval workflow phase (EPIC only): draft → hypothesis_review →
  // business_case → stakeholder_review → approved. Independent of stageGate.
  approvalPhase    String? @map("approval_phase")
  // Active approval revision (EPIC only). Bumped each time a new approval cycle
  // is started on an already-approved Epic; EpicApproval rows are tagged with it.
  approvalRevision Int     @default(1) @map("approval_revision")

  // Epic approval metadata (set when an Epic is approved)
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  approvalComment String?   @map("approval_comment") @db.Text

  // Reifegrad-Modell v2: Impact Recognition. Wird vom Controlling über
  // confirmEpicImpact gestempelt; L5 = "Impact realisiert" ist genau der
  // Zustand impactRecognizedAt != null.
  impactRecognizedAt DateTime? @map("impact_recognized_at")
  impactRecognizedBy String?   @map("impact_recognized_by") @db.Uuid
  impactComment      String?   @map("impact_comment") @db.Text

  // SAFe Portfolio Guardrails (Roadmap-G1).
  // EPIC-only: epicType klassifiziert das Investment (Solution = grosser
  // Cross-ART-Brocken, Epic = Standard, Enabler = Architectural Runway /
  // Compliance / NFR). investmentHorizon: H1 (Sustain), H2 (Grow),
  // H3 (Innovate) — McKinsey-3-Horizons-Modell.
  epicType          String? @map("epic_type")
  investmentHorizon String? @map("investment_horizon")
  // FEATURE-only: feature vs enabler (Architectural Runway etc.).
  featureType       String? @map("feature_type")

  // Governance flags (EPIC only): surface the Epic in the next steering /
  // budgeting meeting. Toggled on the Epic overview tab.
  needsSteeringAttention Boolean @default(false) @map("needs_steering_attention")
  stagedForBudgeting     Boolean @default(false) @map("staged_for_budgeting")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  parent      Initiative?       @relation("Hierarchy", fields: [parentId], references: [id])
  children    Initiative[]      @relation("Hierarchy")
  valueStream ValueStream?      @relation("EpicValueStream", fields: [valueStreamId], references: [id])
  art         Art?              @relation("FeatureArt", fields: [artId], references: [id])
  pi          ProgramIncrement? @relation(fields: [piId], references: [id])

  dependenciesOut  Dependency[]      @relation("From")
  dependenciesIn   Dependency[]      @relation("To")
  kpis             Kpi[]
  epicApprovals    EpicApproval[]
  themeLinks       ThemeEpicLink[]
  goalLinks        GoalEpicLink[]
  budgetAllocation BudgetAllocation?

  @@index([tenantId])
  @@index([parentId])
  @@index([piId])
  @@index([ownerId, status])
  @@index([path])
  // Cockpit-Hot-Paths: features filtered by (tenant, art) + PI/level — composite
  // indexes decken die groupBy- und findMany-Filter in umsetzung-cockpit-view ab.
  @@index([tenantId, artId, piId])
  @@index([tenantId, artId, level])
  @@map("initiatives")
}

model EpicApproval {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  initiativeId String @map("initiative_id") @db.Uuid

  revision       Int     @default(1) // approval cycle this row belongs to
  kind           String // "party" | "section"
  party          String? // ApprovalParty (kind=party): mgmt | business_owner | finance | irt_owner | lace_vmo
  section        String? // kind=section: "breakdown" | "kpis"
  approverUserId String? @map("approver_user_id") @db.Uuid // assigned approver (party) / reviewer (section)

  status      String    @default("pending") // pending | approved | rejected
  decidedAt   DateTime? @map("decided_at")
  comment     String?   @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at")
  createdBy   String    @map("created_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  initiative Initiative @relation(fields: [initiativeId], references: [id])

  @@index([tenantId, initiativeId, revision])
  @@index([approverUserId, status])
  @@map("epic_approvals")
}

model Kpi {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  initiativeId  String   @map("initiative_id") @db.Uuid
  name          String
  unit          String?
  baseline      Decimal? @db.Decimal(14, 2)
  target        Decimal? @db.Decimal(14, 2)
  measurements  Json // [{ date: ISO, value: number }] — time series of actuals
  // Share of the Epic's recurring benefit this KPI realises (fraction 0..1);
  // null = unset → the dashboard splits the benefit equally across the KPIs.
  benefitWeight Decimal? @map("benefit_weight") @db.Decimal(6, 4)
  /// Finance Controller valuation: € per natural unit of improvement
  /// baseline→target (e.g. € per day saved, € per +1 % NPS).
  valuePerUnit  Decimal? @map("value_per_unit") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  initiative    Initiative          @relation(fields: [initiativeId], references: [id])
  krContributions KrKpiContribution[]

  @@index([tenantId, initiativeId])
  @@map("kpis")
}

/// Participatory Budgeting: one row per Epic in the current budgeting round.
/// `allocations` holds the granted amount per half-year period, e.g.
/// { "2026-H1": 120000 }. `hypothesisBudget` is the fixed budget for
/// hypothesis-only Epics (no business-case cost slices). The scheduled start
/// lives on the Epic timeline (timeline.estimates.backlog), not here.
model BudgetAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  epicId           String   @unique @map("epic_id") @db.Uuid
  priority         Int      @default(0)
  hypothesisBudget Decimal? @map("hypothesis_budget") @db.Decimal(14, 2)
  allocations      Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  initiative Initiative @relation(fields: [epicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("budget_allocations")
}

/// Finance's breakdown of a Value Stream's budget to its ARTs, per half-year
/// ("YYYY-H1" → amount). One row per ART. Mirrors BudgetAllocation; the VS budget
/// it draws against is derived from participatory budgeting (getValueStreamBudgets).
model ArtBudget {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  artId     String   @unique @map("art_id") @db.Uuid
  byPeriod  Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  art    Art    @relation(fields: [artId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("art_budgets")
}

/// An immutable snapshot of the participatory-budgeting plan for one
/// half-year cycle ("YYYY-H1" | "-H2"). Captures the Epic priorisation,
/// the per-Epic allocations across all occupied half-years, the
/// Value-Stream + ART roll-ups, and the Features that were assigned to
/// PIs within the captured cycle — enough to render the snapshot without
/// touching the live tables. Re-capturing within the same cycle updates
/// the row (idempotent per `(tenantId, cycleKey)`).
model BudgetPlanRevision {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  cycleKey   String   @map("cycle_key") // "YYYY-H1" | "YYYY-H2"
  capturedAt DateTime @default(now()) @map("captured_at")
  capturedBy String   @map("captured_by") @db.Uuid
  // Frozen BudgetPlanSnapshot — see src/domain/budget-plan-snapshot.ts.
  payload    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cycleKey])
  @@index([tenantId, capturedAt(sort: Desc)])
  @@map("budget_plan_revisions")
}

model Dependency {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fromId    String   @map("from_id") @db.Uuid
  toId      String   @map("to_id") @db.Uuid
  type      String // 'blocks' | 'depends_on' | 'relates_to'
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  from Initiative @relation("From", fields: [fromId], references: [id])
  to   Initiative @relation("To", fields: [toId], references: [id])

  @@unique([fromId, toId, type])
  @@map("dependencies")
}

/// Persistierte Netzplan-Layout-Position pro Feature (Initiative auf
/// Feature-Level) im Scope eines Epics. Tenant-weit; alle User sehen
/// dasselbe Layout. Wenn ein Knoten kein Eintrag hat (z. B. neu via
/// Quick-Add), fällt der Client auf dagre-Layout zurück.
model InitiativeGraphPosition {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  epicId       String   @map("epic_id") @db.Uuid
  initiativeId String   @map("initiative_id") @db.Uuid
  x            Float
  y            Float
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String   @map("updated_by") @db.Uuid

  @@unique([epicId, initiativeId])
  @@index([tenantId, epicId])
  @@map("initiative_graph_positions")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actorId      String   @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  changes      Json?
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  traceId      String?  @map("trace_id")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model UserRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  role           String
  valueStreamIds String[] @map("value_stream_ids") @db.Uuid
  artIds         String[] @map("art_ids") @db.Uuid
  teamIds        String[] @map("team_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role])
  @@map("user_role_assignments")
}

/// Pro-Tenant editierbares Mapping Rolle → Capability. Default-Bundle wird
/// aus `POLICIES` in `src/server/auth/policies/index.ts` gespeist (siehe
/// Plan-Datei Capability-Übersicht); jeder Tenant kann delta-editieren
/// (Capability hinzufügen / entziehen / Scope ändern).
///
/// PR A baut nur die Tabelle + den Backfill. `authorize()` arbeitet weiter
/// gegen den Code; PR B macht den Resolver-Switch.
model RoleCapability {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String
  action    String
  /// Optionaler Scope-Override: "value_stream" | "art" | "team" | "own".
  /// null = unscoped. Validierung gegen die `ScopeCheck`-Union erfolgt im
  /// Service-Layer (Zod-Schema), nicht im Schema (Prisma hat keine Enums
  /// hier, um den Aufwand der Migration klein zu halten).
  scope     String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  @@unique([tenantId, role, action])
  @@index([tenantId, role])
  @@map("role_capabilities")
}

model Impediment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  artId       String    @map("art_id") @db.Uuid
  piId        String?   @map("pi_id") @db.Uuid
  title       String
  description String?   @db.Text
  severity    String    @default("medium") // low | medium | high | critical
  status      String    @default("open") // open | escalated | resolved
  // ROAM-Status für die PI-Closure: open | resolved | owned | accepted |
  // mitigated. Ergänzt — nicht ersetzt — den Workflow-Status; nur für die
  // Closure-Sicht relevant.
  roamStatus  String    @default("open") @map("roam_status")
  roamedAt    DateTime? @map("roamed_at")
  roamedBy    String?   @map("roamed_by") @db.Uuid
  raisedBy    String    @map("raised_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolution  String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  art    Art               @relation(fields: [artId], references: [id])
  pi     ProgramIncrement? @relation(fields: [piId], references: [id])

  @@index([artId, status])
  @@index([piId])
  @@map("impediments")
}

model JiraConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  cloudId        String   @map("cloud_id") // Atlassian cloud ID
  instanceUrl    String   @map("instance_url") // https://yoursite.atlassian.net
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")
  // projectKey: JSON map of artId → Jira project key, e.g. {"<artId>": "PROJ"}
  projectKeyMap  Json     @default("{}") @map("project_key_map")
  webhookSecret  String   @map("webhook_secret") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("jira_configs")
}

model AzureDevOpsConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  organization   String // e.g. "my-org"
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")
  // projectMap: JSON map of artId → "Organization/Project", e.g. {"<artId>": "myorg/MyProject"}
  projectMap     Json     @default("{}") @map("project_map")
  webhookSecret  String   @map("webhook_secret") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("azure_devops_configs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending") // pending | processed | failed
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   String   @map("response_body") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@map("idempotency_keys")
}
