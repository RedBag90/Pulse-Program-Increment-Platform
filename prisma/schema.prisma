generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  region         String   @db.VarChar(10)
  /// Tenant-Art: "organization" (Klienten-Tenant, Platform-Admin-angelegt) |
  /// "personal" (privater Free-Bereich eines einzelnen Nutzers, auto-erzeugt).
  kind           String   @default("organization")
  /// Lifecycle-Status (Platform-Admin): "active" | "suspended" (gesperrt,
  /// Login-Redirect) | "archived" (stillgelegt, Löschen-Ersatz bei nicht-leeren
  /// Tenants). Nur über die Platform-Admin-API pflegbar.
  status         String   @default("active")
  /// Entitlement-Set (Freemium): Modul-Keys aus src/domain/modules.ts, die dieser
  /// Tenant nutzen darf. Leeres Array = kind-Default (personal → ["ziele"],
  /// organization → alle Module). Pflege ausschließlich über die
  /// Platform-Admin-API — kein tenant-seitiges Self-Service.
  enabledModules String[] @map("enabled_modules")
  createdAt      DateTime @default(now()) @map("created_at")

  // Portfolio Dashboard settings (the "Soll" for the economics view).
  costNeutralTarget   Decimal?  @map("cost_neutral_target") @db.Decimal(14, 2) // self-funding threshold / month
  dashboardHorizonEnd DateTime? @map("dashboard_horizon_end") @db.Date // recurring-benefit accrual end

  // Rolling-Window: die Fenstergröße in Halbjahren (nur Anzeige-Horizont).
  //
  // Der Topf und der aktive Zyklus standen früher ebenfalls hier
  // (`budgetPoolByPeriod`, `activeBudgetCycle`). Beides ist entfallen: der Topf
  // lebt je Kachel in `BudgetRound.poolTotal`, und „aktiv" ist die laufende
  // Kachel (`activeCycleFromRounds`) — einen einzelnen aktiven Zyklus gibt es
  // im Kachel-Modell nicht.
  budgetWindowSize Int @default(4) @map("budget_window_size")

  // Participatory Budgeting: Default-Aufwand (Kosten-Richtwert) für Epics, die
  // erst eine approved Benefit-Hypothese (noch keinen Lean Business Case) haben —
  // grob der Aufwand, um den Business Case zu erarbeiten. `null` ⇒ Code-Fallback
  // (DEFAULT_HYPOTHESIS_EFFORT). Für nur-Hypothese-Kandidaten der Ballot-Richtwert.
  defaultHypothesisEffort Decimal? @map("default_hypothesis_effort") @db.Decimal(14, 2)

  // Conversion rate that turns WSJF Job-Size points into € for the PI-Planning
  // capacity overlay (Σ Job Size × this = €-Demand vs. ART budget). When null,
  // the €-axis of the capacity badge is hidden — Job Size alone is rendered.
  costPerJobSizePoint Decimal? @map("cost_per_job_size_point") @db.Decimal(10, 2)

  // SAFe Portfolio Guardrails (Roadmap-G1). Targets je Achse summieren auf
  // 100 %; Defaults in `src/domain/portfolio-guardrails.ts`.
  guardrailTargets Json? @map("guardrail_targets")

  valueStreams          ValueStream[]
  arts                  Art[]
  initiatives           Initiative[]
  kpis                  Kpi[]
  gateTransitions       StageGateTransition[]
  gateApprovals         StageGateApproval[]
  gateApproverRules     StageGateApproverRule[]
  userRoleAssignments   UserRoleAssignment[]
  jiraConfig            JiraConfig?
  azureDevOpsConfig     AzureDevOpsConfig?
  targetModels          TargetOperatingModel[]
  transformationActions TransformationAction[]
  strategicThemes       StrategicTheme[]
  objectives            Objective[]
  themeEpicLinks        ThemeEpicLink[]
  goalEpicLinks         GoalEpicLink[]
  goalRelatedWork       GoalRelatedWork[]
  goalValueStreamLinks  GoalValueStreamLink[]
  goalArtLinks          GoalArtLink[]
  goalCustomFieldDefs   GoalCustomFieldDef[]
  goalCustomFieldValues GoalCustomFieldValue[]
  budgetAllocations     BudgetAllocation[]
  budgetPlanRevisions   BudgetPlanRevision[]
  budgetRounds          BudgetRound[]
  runTheBusinessItems   RunTheBusinessItem[]
  piStandards           PiStandard[]
  timelines             Timeline[]
  setupProgress         SetupProgress[]
  solutions             Solution[]
  epicSolutions         EpicSolution[]

  @@index([status])
  @@map("tenants")
}

/// Setup-Guide-Fortschritt pro Tenant. Eine Zeile = ein abgehakter Check.
/// Tenant-weit gemeinsam: nur Tenant-Admin (Capability `tenant.users.manage`)
/// darf schreiben; alle eingeloggten User sehen denselben Stand. Reihenfolge
/// + Bedeutung der `checkId` lebt im UI-Code (`src/features/setup/data/milestones.ts`).
model SetupProgress {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  checkId   String   @map("check_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, checkId])
  @@map("setup_progress")
}

/// Per-User gespeicherter Portfolio-Übersicht-Filter: benannte Filter-Sets, die
/// der Nutzer anlegt/anwendet. `criteria` = { vs, gate, status, owner } als JSON.
/// Genau ein `isDefault` je Nutzer wird beim bloßen Öffnen von /portfolio
/// automatisch angewandt. Tenant+User-scoped (plain columns, wie Risk/Impediment).
model SavedPortfolioFilter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  criteria  Json     @default("{}")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, name])
  @@index([tenantId, userId])
  @@map("saved_portfolio_filters")
}

/// Per-User-Quittung + gesehene Tour-Schritte je zugewiesener Rolle
/// (Modul `onboarding`, ADR-0017). Der Key ist die **Rolle**, nicht die
/// Assignment-Row: ein Scope-Edit im Admin ist heute remove + re-add, würde also
/// sonst jedes Mal ein neues Pop-up auslösen.
///
/// `seenStepKeys` ist bewusst eine Menge statt eines Fortschritts-Zeigers: wird
/// ein Modul nachträglich freigeschaltet, sind dessen Tour-Schritte automatisch
/// „offen" und der Nutzer bekommt genau die neuen Aufgaben gezeigt. „Tour
/// abgeschlossen" ist daraus abgeleitet (keine offenen Schritte mehr) und wird
/// nicht gespeichert. Schritt-Keys leben im Code
/// (`src/modules/onboarding/domain/role-playbook.ts`).
/// Tenant+User-scoped (plain columns, wie SavedPortfolioFilter).
model RoleOnboarding {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String
  acknowledgedAt DateTime? @map("acknowledged_at")
  seenStepKeys   String[]  @map("seen_step_keys")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, role])
  @@index([tenantId, userId])
  @@map("role_onboarding")
}

/// A reusable, named PI calendar: a uniform cadence × count anchored at a
/// day/month. Applying it to an ART for a given year generates contiguous PIs
/// named "PI 1" … "PI n" (see [pi-standard.ts](src/domain/pi-standard.ts)),
/// adding only those whose date range is free of existing PIs.
model PiStandard {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  anchorMonth  Int      @map("anchor_month") // 1–12
  anchorDay    Int      @map("anchor_day") // 1–31
  cadenceWeeks Int      @map("cadence_weeks") // e.g. 8
  piCount      Int      @map("pi_count") // e.g. 6
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pi_standards")
}

/// The management-defined target operating model — the "Soll" the transformation
/// drives toward. At most one `active` model per tenant (enforced in the
/// service, which archives the prior active on activation). Nullable structure
/// targets and the practice flags express *which* of SAFe the org actually
/// adopts — the flags are the master switch that scopes which concepts appear.
model TargetOperatingModel {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  status     String    @default("draft") // draft | active | archived
  template   String? // team_level | essential_safe | portfolio_safe | custom
  targetDate DateTime? @map("target_date")

  // Structure targets — null = not part of the target.
  targetValueStreams   Int? @map("target_value_streams")
  targetArtsTotal      Int? @map("target_arts_total")
  targetTeamsTotal     Int? @map("target_teams_total")
  targetPiCadenceWeeks Int? @map("target_pi_cadence_weeks")

  // Enabled practices — which parts of the model the org actually runs.
  portfolioLevel     Boolean @default(true) @map("portfolio_level")
  programLevel       Boolean @default(true) @map("program_level")
  stageGates         Boolean @default(true) @map("stage_gates")
  wsjf               Boolean @default(true)
  multiPartyApproval Boolean @default(true) @map("multi_party_approval")
  featureQs          Boolean @default(true) @map("feature_qs")
  dependencies       Boolean @default(true)
  piObjectives       Boolean @default(true) @map("pi_objectives")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("target_operating_models")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Ziele-Modul V2 — Strategic Theme / Objective / KeyResult / KPI-Bindung
//
//  SAFe-Lean-Portfolio-Management-konforme Hierarchie.
//
//  StrategicTheme dient als versteckter Default-Anchor in der flachen
//  2-Ebenen-Hierarchie (Theme = Objective in der UI). Objective → KeyResult
//  (messbar). KeyResult bindet n:m an existierende `Kpi` (am Epic) via
//  `KrKpiContribution` mit Gewicht — damit rollt der €-Effekt von ganz unten
//  (KPI · valuePerUnit · benefitWeight) durchgaengig nach oben.
// ─────────────────────────────────────────────────────────────────────────────

model StrategicTheme {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  title         String
  narrative     String?  @db.Text
  /// Hex-Color fuer Strategy-Map (Tree-Card-Stripe + Sankey-Band-Farbe).
  color         String   @default("#6366f1")
  /// "business" oder "enabler" (Petras Heimat). Treibt Investment-Mix-
  /// Sicht im Money-Tab.
  kind          String   @default("business")
  /// Lean-Budget-Anker in € pro Jahr (Investment-Bucket). Wird als
  /// Vergleichs-Basis fuer ROI in der Money-Sicht verwendet.
  budgetPlanned Decimal? @map("budget_planned") @db.Decimal(14, 2)
  /// Frei-konfigurierbare Guardrails, JSON (z. B. {minEnablerRatio: 0.2}).
  guardrails    Json?
  ownerId       String?  @map("owner_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  status        String   @default("active") // active | sunsetted | archived
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String   @map("updated_by") @db.Uuid

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  objectives Objective[]
  epicLinks  ThemeEpicLink[]

  @@index([tenantId])
  @@map("strategic_themes")
}

model Objective {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  themeId                String    @map("theme_id") @db.Uuid
  title                  String
  narrative              String?   @db.Text
  /// Zeitraum, kanonisch YYYY-Qn | YYYY-Hn | YYYY (src/domain/goal-period.ts).
  /// Null = kein Zeitraum / Backlog. Ein individueller Bereich (periodStart/End)
  /// gewinnt über diesen Bucket, wenn gesetzt.
  period                 String?
  /// Individueller Umsetzungszeitraum (Start/Ende) — Alternative zum Bucket
  /// `period`. Beide gesetzt ⇒ Range gewinnt; Roadmap/Sortierung/Filter nutzen ihn.
  periodStart            DateTime? @map("period_start")
  periodEnd              DateTime? @map("period_end")
  /// Knotentyp (Goal-Knoten-Vereinheitlichung): "objective" | "key_result".
  /// Rein Label-unterscheidend — jeder Knoten kann Kinder UND/ODER eine Metrik
  /// tragen; hat er Kinder, gewinnt der Rollup über die eigene Metrik.
  nodeKind               String    @default("objective") @map("node_kind")
  /// Self-Referenz für beliebig tiefe Zielkaskaden. Null = Top-Level unter Theme.
  parentObjectiveId      String?   @map("parent_objective_id") @db.Uuid
  /// Tiefe (0 = Top-Level) + materialisierter Pfad (Muster wie Initiative).
  level                  Int       @default(0)
  path                   String    @default("")
  // ── Metrik (aus KeyResult verschmolzen; nur bei messbaren Blättern gesetzt) ──
  metricName             String?   @map("metric_name")
  metricUnit             String?   @map("metric_unit")
  metricType             String    @default("number") @map("metric_type")
  precision              Int       @default(0)
  currencyCode           String?   @map("currency_code")
  rollupWeight           Decimal?  @map("rollup_weight") @db.Decimal(6, 4)
  /// Asana „Remove from automatic progress": false blendet diesen Knoten aus
  /// dem Fortschritt/€-Rollup des Elternteils aus. Default true = zählt mit.
  includeInParentRollup  Boolean   @default(true) @map("include_in_parent_rollup")
  /// Wert-Kaskade (Einheiten-Achse, orthogonal zu rollupWeight/Progress): wieviel
  /// der ELTERN-Metrik-Einheit dieser Knoten je 1 Einheit eigener Bewegung
  /// beiträgt (z. B. Kind misst „Wagen", Eltern „€" → 10000). Null = kein
  /// einheiten-basierter Wertbeitrag ins Eltern-Aggregat (Alt-Verhalten).
  parentUnitPerChildUnit Decimal?  @map("parent_unit_per_child_unit") @db.Decimal(18, 6)
  baseline               Decimal?  @db.Decimal(14, 4)
  target                 Decimal?  @db.Decimal(14, 4)
  current                Decimal?  @db.Decimal(14, 4)
  /// Fortschrittsquelle (src/domain/goal-progress-mode.ts): manual | rollup |
  /// auto_kpi | kpi_tree. Null = abgeleitet (Kinder → rollup, sonst manual) =
  /// Alt-Verhalten.
  progressMode           String?   @map("progress_mode")
  ownerId                String?   @map("owner_id") @db.Uuid
  /// Verantwortliches Team (Asana „Accountable team"). Null = kein Team.
  accountableTeamId      String?   @map("accountable_team_id") @db.Uuid
  sortOrder              Int       @default(0) @map("sort_order")
  /// Goal-Status (src/domain/goal-status.ts). Null = kein Check-in ("No
  /// recent updates"). Open: on_track | at_risk | off_track. Closed:
  /// achieved | partial | missed | dropped.
  status                 String?
  dueDate                DateTime? @map("due_date")
  /// Gesetzt, sobald ein Closed-Status gewaehlt wird.
  closedAt               DateTime? @map("closed_at")
  /// Lessons-Learned-Notiz, gepflegt beim Quartal-Reset-Wizard.
  closingNote            String?   @map("closing_note") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String    @map("created_by") @db.Uuid
  updatedBy              String    @map("updated_by") @db.Uuid

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  theme             StrategicTheme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  parent            Objective?             @relation("GoalHierarchy", fields: [parentObjectiveId], references: [id])
  children          Objective[]            @relation("GoalHierarchy")
  checkins          GoalCheckin[]
  comments          GoalComment[]
  epicLinks         GoalEpicLink[]
  relatedWork       GoalRelatedWork[]
  valueStreamLinks  GoalValueStreamLink[]
  artLinks          GoalArtLink[]
  customFieldValues GoalCustomFieldValue[]

  @@index([tenantId])
  @@index([themeId])
  @@index([period])
  @@index([parentObjectiveId])
  @@index([path])
  @@index([accountableTeamId])
  @@map("objectives")
}

/// Status-/Progress-Check-in an einem Ziel (Objective ODER Key Result) —
/// Asana-artige Historie. Genau eine der beiden FKs ist gesetzt. `status =
/// null` markiert ein reines Progress-Update (kein Status-Event). `value`
/// traegt den rohen KR-Ist-Wert, `progress` den normalisierten 0..1-Snapshot.
/// Backt „Latest status" + Verlaufschart.
model GoalCheckin {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String?  @map("objective_id") @db.Uuid
  status      String?
  value       Decimal? @db.Decimal(14, 4)
  progress    Decimal? @db.Decimal(14, 4)
  note        String?  @db.Text
  /// Strukturiertes Status-Update (Epic 4): Array [{title, body}]. Null =
  /// nur `note`/kein Freitext (rückwärtskompatibel).
  sections    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectiveId, createdAt])
  @@map("goal_checkins")
}

/// Freitext-Kommentar an einem Ziel (Objective ODER Key Result) fuer den
/// Aktivitaets-Feed. Genau eine der beiden FKs ist gesetzt.
model GoalComment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String?  @map("objective_id") @db.Uuid
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  objective Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectiveId, createdAt])
  @@map("goal_comments")
}

/// Theme ↔ Epic n:m (Theme-direkte Verlinkung ohne KR-Schritt — z. B.
/// fuer Epics die einen Theme-Beitrag liefern, aber keinen messbaren KR).
model ThemeEpicLink {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  themeId   String   @map("theme_id") @db.Uuid
  epicId    String   @map("epic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  theme  StrategicTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  epic   Initiative     @relation(fields: [epicId], references: [id])

  @@unique([themeId, epicId])
  @@index([tenantId])
  @@index([epicId])
  @@map("theme_epic_links")
}

/// Ziel ↔ Epic Direktverknüpfung ("Related work"). Ein Epic kann an mehrere
/// Ziel-Knoten gehängt werden — je Link OPTIONAL über eine gewählte Erfolgs-KPI
/// (`kpiId`) + Einheiten-Umrechnungsfaktor (`conversionFactor`) wertbringend.
/// Count-once liegt jetzt auf KPI-Ebene (`@@unique([kpiId])`, NULLs distinct)
/// statt Epic-Ebene: jede einzelne KPI erreicht den Ziel-Baum über genau einen
/// Mechanismus (GoalEpicLink ODER KrKpiContribution). Alt-Zeilen (kpiId=null)
/// bleiben Ganz-Epic-€-Links (goals-rollup epicLinkTrio).
model GoalEpicLink {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  objectiveId       String   @map("objective_id") @db.Uuid
  epicId            String   @map("epic_id") @db.Uuid
  /// Gewählte Erfolgs-KPI dieses Epics, die DIESES Ziel treibt. Null = Alt-
  /// Verhalten (ganzes Epic, alle KPIs, €-Pfad über epicLinkTrio).
  kpiId             String?  @map("kpi_id") @db.Uuid
  /// Ziel-Metrik-Einheit je 1 Einheit der gewählten Epic-KPI (Unit→Unit-Konversion,
  /// z. B. 10000 €/Wagon). Nur bei gesetztem kpiId sinnvoll.
  conversionFactor  Decimal? @map("conversion_factor") @db.Decimal(18, 6)
  /// Wirkungsart DIESES Links: "one_time" | "recurring". Entkoppelt von der
  /// KPI-eigenen benefitKind — dieselbe KPI kann an Ziel A einmalig, an Ziel B
  /// wiederkehrend wirken (Wagen-Beispiel).
  impactKind        String   @default("recurring") @map("impact_kind")
  /// Bei impactKind="recurring": "monthly" | "yearly" Run-Rate.
  recurringInterval String   @default("yearly") @map("recurring_interval")
  /// Plan-Schnappschuss zur Business-Case-Freigabe (L2 → L3.1):
  /// `{ conversionFactor, impactKind, recurringInterval }` — dasselbe Prinzip
  /// wie `Kpi.planSnapshot`, nur für den Beitrag aufs Ziel.
  planSnapshot      Json?    @map("plan_snapshot")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  objective Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  epic      Initiative @relation(fields: [epicId], references: [id], onDelete: Cascade)
  kpi       Kpi?       @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([epicId, objectiveId])
  @@unique([kpiId])
  @@index([tenantId, objectiveId])
  @@index([epicId])
  @@map("goal_epic_links")
}

/// Ziel ↔ Related Work (referenziell, kein Wertbeitrag). `kind` = "feature" | "pi";
/// `refId` verweist auf eine Initiative (Feature, level 1) bzw. ein
/// ProgramIncrement (polymorph, daher keine harte FK — Existenz im Service).
/// Epics laufen separat wertbringend über GoalEpicLink.
model GoalRelatedWork {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String   @map("objective_id") @db.Uuid
  kind        String
  refId       String   @map("ref_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, kind, refId])
  @@index([tenantId, objectiveId])
  @@map("goal_related_work")
}

/// Ziel ↔ Value-Stream-Verantwortung (Epic 6a, n:m). Additiv, ohne Auth-Eingriff
/// — ein Ziel kann mehreren Value Streams zugeordnet sein. Rein organisatorisch.
model GoalValueStreamLink {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  objectiveId   String   @map("objective_id") @db.Uuid
  valueStreamId String   @map("value_stream_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String   @map("created_by") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  objective   Objective   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  valueStream ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, valueStreamId])
  @@index([tenantId, objectiveId])
  @@index([valueStreamId])
  @@map("goal_value_stream_links")
}

/// Ziel ↔ ART-Verantwortung (Epic 6a, n:m). Wie GoalValueStreamLink für ARTs.
model GoalArtLink {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  objectiveId String   @map("objective_id") @db.Uuid
  artId       String   @map("art_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  art       Art       @relation(fields: [artId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, artId])
  @@index([tenantId, objectiveId])
  @@index([artId])
  @@map("goal_art_links")
}

/// Tenant-weit definierbares Custom Field an Ziel-Knoten (Epic 7). Der
/// Tenant-Admin verwaltet die Definitionen; Werte hängen je Knoten an
/// `GoalCustomFieldValue`. `type` als validierter String (kein Prisma-Enum,
/// wie Objective.metricType / RoleCapability.scope).
model GoalCustomFieldDef {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// "text" | "number" | "select" — im zod-Layer validiert.
  type      String   @default("text")
  /// Nur bei type=select: Array erlaubter Werte (JSON).
  options   Json?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant Tenant                 @relation(fields: [tenantId], references: [id])
  values GoalCustomFieldValue[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("goal_custom_field_defs")
}

/// Custom-Field-Wert an einem Ziel-Knoten (Epic 7). Genau ein Wert je
/// (Knoten, Definition). Wert serialisiert als String; Parsen/Validieren am
/// Domain-Seam (src/domain/goal-custom-field.ts).
model GoalCustomFieldValue {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  defId       String   @map("def_id") @db.Uuid
  objectiveId String   @map("objective_id") @db.Uuid
  value       String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String   @map("updated_by") @db.Uuid

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  def       GoalCustomFieldDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  objective Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, defId])
  @@index([tenantId, objectiveId])
  @@map("goal_custom_field_values")
}

/// A tracked transformation action — the "Steuern" backlog that moves the
/// organisation from Ist toward the Soll. Management-owned, tenant-scoped.
model TransformationAction {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  title     String
  status    String    @default("open") // open | in_progress | done
  ownerId   String?   @map("owner_id") @db.Uuid
  dueDate   DateTime? @map("due_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("transformation_actions")
}

/// A daily point-in-time capture of the transformation's headline metrics — the
/// "Reise über Zeit". One row per tenant per day (idempotent upsert), so the
model ValueStream {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  description       String?
  budgetAmount      Decimal?  @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency    String?   @map("budget_currency") @db.Char(3)
  // Governance: who signs off Epics in this value stream (Finance party) and the
  // responsible VMO — loose user ids (users live in Supabase auth).
  financeApproverId String?   @map("finance_approver_id") @db.Uuid
  vmoId             String?   @map("vmo_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  arts              Art[]
  epics             Initiative[]            @relation("EpicValueStream")
  goalLinks         GoalValueStreamLink[]
  gateApproverRules StageGateApproverRule[]
  rtbItems          RunTheBusinessItem[]
  solutions         Solution[]

  // Uniqueness among *active* (non-deleted) rows is enforced by a partial unique
  // index created out-of-band (see prisma/manual-indexes.sql) — Prisma can't
  // express `WHERE deleted_at IS NULL`, so the table-level @@unique is dropped.
  @@map("value_streams")
}

model Art {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  valueStreamId  String    @map("value_stream_id") @db.Uuid
  name           String
  description    String?
  /// Default cadence for new PIs on ARTs not yet subscribed to a Timeline
  /// (legacy fallback). Timelines no longer carry a cadence — each PI defines
  /// its own start/end window.
  piCadenceWeeks Int       @default(10) @map("pi_cadence_weeks")
  rteId          String?   @map("rte_id") @db.Uuid // Release Train Engineer
  /// Subscription to a shared Timeline. Each ART belongs to at most one
  /// Timeline; nullable during the rollout so brand-new ARTs (or those that
  /// left a Timeline) live without one. The PI grid the ART planss against
  /// comes from `timeline.programIncrements`.
  timelineId     String?   @map("timeline_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  valueStream ValueStream        @relation(fields: [valueStreamId], references: [id])
  timeline    Timeline?          @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  pis         ProgramIncrement[]
  features    Initiative[]       @relation("FeatureArt")
  issues      Issue[]
  goalLinks   GoalArtLink[]
  solutions   Solution[]

  // Active-row uniqueness via a partial unique index (see prisma/manual-indexes.sql).
  @@index([timelineId])
  @@map("arts")
}

/// SAFe Solution — das langlebige Produkt/System zwischen Value Stream und Epic.
/// Trägt den Investitionshorizont (Lebenszyklus): h3 R&D → h2 Emerging → h1
/// Investing/Extracting → h0 Decommissioning. Epics verändern Solutions; der
/// Horizont eines Epics wird aus seiner Primär-Solution abgeleitet.
model Solution {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  valueStreamId  String    @map("value_stream_id") @db.Uuid
  artId          String?   @map("art_id") @db.Uuid
  name           String
  description    String?
  /// h0 (Decommissioning) | h1 (Investing) | h2 (Emerging) | h3 (R&D).
  horizon        String    @default("h1")
  /// Nur in H1 relevant: "investing" | "extracting". Sonst null.
  investmentMode String?   @map("investment_mode")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String    @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String    @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  valueStream    ValueStream          @relation(fields: [valueStreamId], references: [id])
  art            Art?                 @relation(fields: [artId], references: [id], onDelete: SetNull)
  epicLinks      EpicSolution[]
  primaryOfEpics Initiative[]         @relation("EpicPrimarySolution")
  /// Betriebskosten dieser Solution — die **eine** Run-the-Business-Definition
  /// (Modul Budgeting). Grow wird weiterhin aus den Primär-Epics abgeleitet.
  rtbItems       RunTheBusinessItem[]

  @@index([tenantId, valueStreamId])
  @@index([tenantId, horizon])
  @@map("solutions")
}

/// n:m-Zuordnung Epic ↔ Solution (voller Zuordnungssatz). Die Primär-Solution
/// steht zusätzlich als `Initiative.primarySolutionId` und muss hier enthalten sein.
model EpicSolution {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  epicId     String   @map("epic_id") @db.Uuid
  solutionId String   @map("solution_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String   @map("created_by") @db.Uuid

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  epic     Initiative @relation(fields: [epicId], references: [id], onDelete: Cascade)
  solution Solution   @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([epicId, solutionId])
  @@index([tenantId, solutionId])
  @@map("epic_solutions")
}

model ProgramIncrement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Legacy direct link to ART. Backfilled into `timelineId` during rollout;
  /// kept nullable for transitional safety and dropped in a cleanup PR.
  artId      String?  @map("art_id") @db.Uuid
  /// The PI's owning Timeline. Nullable only during the migration window;
  /// new PIs must always carry a timelineId.
  timelineId String?  @map("timeline_id") @db.Uuid
  name       String
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  status     String   @default("planned")

  // PI Planning capacity (overrides). When null, the auto-prorated value from
  // the ART budget is used for the €-axis; Job-Size capacity is "unlimited"
  // (no over-allocation flag).
  capacityJobSize Int?     @map("capacity_job_size")
  capacityAmount  Decimal? @map("capacity_amount") @db.Decimal(14, 2)

  // PI-Closure-Metadaten — vom RTE via Closure-Wizard gesetzt; werden vom
  // pre-check in `completePi` zwingend erwartet, bevor das PI auf
  // "completed" gehen darf.
  systemDemoAt       DateTime? @map("system_demo_at") @db.Date
  inspectAdaptAt     DateTime? @map("inspect_adapt_at") @db.Date
  retrospectiveNotes String?   @map("retrospective_notes") @db.Text
  retrospectiveAt    DateTime? @map("retrospective_at")

  art         Art?         @relation(fields: [artId], references: [id])
  timeline    Timeline?    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  initiatives Initiative[]
  issues      Issue[]
  systemDemo  SystemDemo?

  @@unique([timelineId, name])
  @@index([timelineId])
  @@index([tenantId, status])
  @@map("program_increments")
}

/// A shared PI cadence. ARTs subscribe to a Timeline (via `Art.timelineId`)
/// and plan their Features against the Timeline's PIs instead of owning a
/// private PI list. Reduces duplication when multiple ARTs follow the same
/// rhythm; one Timeline → many ARTs → one shared PI grid.
model Timeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  arts              Art[]
  programIncrements ProgramIncrement[]

  @@index([tenantId])
  @@map("timelines")
}

/// System Demo pro PI. Wird beim PI-Closure-Wizard mit Inhalten gefuellt,
/// vom RTE und Feature Ownern gepflegt. Ein PI hat genau einen SystemDemo
/// (Unique-Constraint). Items werden als geordnete Liste gehalten
/// (`position`).
model SystemDemo {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  piId         String    @unique @map("pi_id") @db.Uuid
  scheduledAt  DateTime? @map("scheduled_at")
  recordingUrl String?   @map("recording_url")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String    @map("created_by") @db.Uuid

  pi    ProgramIncrement @relation(fields: [piId], references: [id])
  items SystemDemoItem[]

  @@index([tenantId])
  @@map("system_demos")
}

model SystemDemoItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  demoId    String   @map("demo_id") @db.Uuid
  /// Optional: ein Demo-Item kann sich auf ein Feature beziehen
  /// (Owner wird dann typischerweise daraus abgeleitet).
  featureId String?  @map("feature_id") @db.Uuid
  title     String
  ownerId   String?  @map("owner_id") @db.Uuid
  presented Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  demo SystemDemo @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId])
  @@index([featureId])
  @@map("system_demo_items")
}

model Initiative {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  level    Int // 0=EPIC, 1=FEATURE
  parentId String? @map("parent_id") @db.Uuid
  path     String // materialized path

  title       String
  description String?  @db.Text
  ownerId     String?  @map("owner_id") @db.Uuid // null until an owner is nominated (Epics start unassigned)
  assigneeIds String[] @map("assignee_ids") @db.Uuid

  // Level-specific foreign keys
  valueStreamId String? @map("value_stream_id") @db.Uuid // EPIC only
  artId         String? @map("art_id") @db.Uuid // EPIC (Pflicht beim Anlegen) + FEATURE
  piId          String? @map("pi_id") @db.Uuid // FEATURE only

  // WSJF fields (FEATURE only)
  wsjfBusinessValue   Int?     @map("wsjf_business_value")
  wsjfTimeCriticality Int?     @map("wsjf_time_criticality")
  wsjfRiskReduction   Int?     @map("wsjf_risk_reduction")
  wsjfJobSize         Int?     @map("wsjf_job_size")
  wsjfComputed        Decimal? @map("wsjf_computed") @db.Decimal(5, 2)

  // Epic artefacts (EPIC only – stored as versioned JSON)
  benefitHypothesis Json? @map("benefit_hypothesis") // L1 Reviewing
  businessCase      Json? @map("business_case") // L2 Analyzing

  // Snapshot of the last approved revision's artefacts (EPIC only), captured at
  // startRevision — the baseline the side-by-side revision diff compares against.
  baselineBenefitHypothesis Json? @map("baseline_benefit_hypothesis")
  baselineBusinessCase      Json? @map("baseline_business_case")

  // Epic timeline (EPIC only): owner-set estimates + manual actuals (backlog,
  // implementation) as a flat JSON; auto actuals live in the columns below.
  timeline                  Json?     @map("timeline")
  selectedForDetailingAt    DateTime? @map("selected_for_detailing_at") // stamped when the Epic enters L1
  hypothesisApprovedAt      DateTime? @map("hypothesis_approved_at")
  selectedForAnalyzingAt    DateTime? @map("selected_for_analyzing_at") // stamped when the Epic enters L2
  businessCaseApprovedAt    DateTime? @map("business_case_approved_at")
  implementationStartedAt   DateTime? @map("implementation_started_at") // stamped when the Epic enters L4
  /// L4.2 „Umsetzung fertig" — gesetzt, wenn der beantragte Schritt L4→L4.2
  /// abgenommen wurde. Spiegelt sich als `timeline.actuals.implementation`.
  implementationCompletedAt DateTime? @map("implementation_completed_at")

  // Geplantes Umsetzungsfenster (EPIC only): the owner-set "Soll" window for
  // when the Epic should be in delivery. Roadmap shows this alongside the
  // derived "Ist" window (the span of its Features' PIs); divergences surface
  // as warnings without blocking scheduling.
  plannedStartAt DateTime? @map("planned_start_at") @db.Date
  plannedEndAt   DateTime? @map("planned_end_at") @db.Date

  // Acceptance criteria (FEATURE only)
  acceptanceCriteria String[] @map("acceptance_criteria")

  // External system sync (e.g. Jira issue key "PROJ-123")
  externalId     String? @map("external_id")
  externalSystem String? @map("external_system") // "jira" | "ado"

  /// Reifegrad L0–L5 (EPIC only). Bewegt sich ausschliesslich über einen
  /// abgenommenen `StageGateTransition` — nie als Nebenwirkung eines anderen
  /// Vorgangs. Die früheren `proposed_*`-Vorschlagsspalten sind mit ADR-0018
  /// entfallen: ein Vorschlag ist jetzt ein Antrag mit eigener Zeile, Historie
  /// und namentlichen Abnahmen.
  stageGate   String    @default("L0") @map("stage_gate")
  status      String    @default("draft")
  /// Ist-Lieferdatum (FEATURE only): gestempelt beim Delivery-Übergang nach
  /// "completed", geleert bei Rücknahme. Basis für Plantreue/Terminabweichung
  /// im LPM-Portfolio-Review (Soll = Plan-PI-Ende).
  completedAt DateTime? @map("completed_at")

  // Epic approval metadata (set when an Epic is approved)
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  approvalComment String?   @map("approval_comment") @db.Text

  // Reifegrad-Modell v2: Impact Recognition. Wird vom Controlling über
  // confirmEpicImpact gestempelt; L5 = "Impact realisiert" ist genau der
  // Zustand impactRecognizedAt != null.
  impactRecognizedAt DateTime? @map("impact_recognized_at")
  impactRecognizedBy String?   @map("impact_recognized_by") @db.Uuid
  impactComment      String?   @map("impact_comment") @db.Text

  // SAFe Portfolio Guardrails (Roadmap-G1).
  // EPIC-only: epicType klassifiziert das Investment (Solution = grosser
  // Cross-ART-Brocken, Epic = Standard, Enabler = Architectural Runway /
  // Compliance / NFR). investmentHorizon: H1 (Sustain), H2 (Grow),
  // H3 (Innovate) — McKinsey-3-Horizons-Modell.
  epicType          String? @map("epic_type")
  // Vestigial: der Investitionshorizont kommt jetzt aus der Primär-Solution
  // (primarySolutionId). Spalte bleibt nullbar, wird nicht mehr gelesen/geschrieben.
  investmentHorizon String? @map("investment_horizon")
  // EPIC only: Primär-Solution → liefert den abgeleiteten Horizont. Weitere
  // Zuordnungen in EpicSolution; die Primär-Solution muss dort enthalten sein.
  primarySolutionId String? @map("primary_solution_id") @db.Uuid
  // FEATURE-only: feature vs enabler (Architectural Runway etc.).
  featureType       String? @map("feature_type")

  // Governance flags (EPIC only): surface the Epic in the next steering /
  // budgeting meeting. Toggled on the Epic overview tab.
  needsSteeringAttention Boolean @default(false) @map("needs_steering_attention")
  stagedForBudgeting     Boolean @default(false) @map("staged_for_budgeting")

  // "I need help" (EPIC only): der Epic-Owner bittet um Unterstützung. Gesetzt =
  // es entsteht in „Meine Tasks" ein Hinweis für den VMO des Wertstroms und alle
  // Portfolio-Manager. `helpRequestedAt` null = keine offene Bitte.
  helpRequestedAt DateTime? @map("help_requested_at")
  helpRequestedBy String?   @map("help_requested_by") @db.Uuid

  // Participatory-Budgeting-Einreichungsfelder (EPIC only). `mandatory` = vorab
  // gesetztes Pflichtvorhaben (vom Topf abgezogen, nicht auf dem Ballot).
  // `costToMvp` = kanonische Kosten-bis-MVP als eine Zahl (PB-Verteileinheit).
  mandatory        Boolean  @default(false)
  costToMvp        Decimal? @map("cost_to_mvp") @db.Decimal(14, 2)
  riskRating       String?  @map("risk_rating") // hoch | mittel | gering
  problemStatement String?  @map("problem_statement")
  mvpCut           String?  @map("mvp_cut")
  ifNotFunded      String?  @map("if_not_funded")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  parent      Initiative?       @relation("Hierarchy", fields: [parentId], references: [id])
  children    Initiative[]      @relation("Hierarchy")
  valueStream ValueStream?      @relation("EpicValueStream", fields: [valueStreamId], references: [id])
  art         Art?              @relation("FeatureArt", fields: [artId], references: [id])
  pi          ProgramIncrement? @relation(fields: [piId], references: [id])

  primarySolution Solution?      @relation("EpicPrimarySolution", fields: [primarySolutionId], references: [id], onDelete: SetNull)
  solutionLinks   EpicSolution[]

  dependenciesOut  Dependency[]          @relation("From")
  dependenciesIn   Dependency[]          @relation("To")
  kpis             Kpi[]
  gateTransitions  StageGateTransition[]
  themeLinks       ThemeEpicLink[]
  goalLinks        GoalEpicLink[]
  budgetAllocation BudgetAllocation?
  groupAllocations GroupAllocation[]
  budgetDecisions  BudgetDecision[]
  issues           Issue[]

  @@index([tenantId])
  @@index([parentId])
  @@index([piId])
  @@index([ownerId, status])
  @@index([path])
  // Cockpit-Hot-Paths: features filtered by (tenant, art) + PI/level — composite
  // indexes decken die groupBy- und findMany-Filter in umsetzung-cockpit-view ab.
  @@index([tenantId, artId, piId])
  @@index([tenantId, artId, level])
  @@map("initiatives")
}

/// Ein **beantragter** Reifegrad-Wechsel (Stage Gate) an einem Epic — die
/// Kopfzeile: wer hat wann welchen Push beantragt, mit welchem Ergebnis. Die
/// namentlichen Abnahmen hängen als `StageGateApproval` daran.
///
/// Seit die inhaltlichen Freigaben in die Reifegrad-Schritte aufgegangen sind
/// (L0 → L1 trägt die Hypothese, L2 → L3.1 den Business Case), ist das die
/// **einzige** Freigabe-Tabelle: die frühere Mehrparteien-Achse `EpicApproval`
/// samt `approval_phase`/`approval_revision` ist damit entfallen — siehe
/// ADR-0018 und den Nachtrag zu ADR-0003.
model StageGateTransition {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  initiativeId String @map("initiative_id") @db.Uuid

  fromGate String @map("from_gate") // StageGate L0..L5
  toGate   String @map("to_gate") // StageGate L0..L5
  kind     String @default("forward") // "forward" (Antrag mit Abnahmen) | "revert" (Korrektur)

  status      String    @default("pending") // pending | approved | rejected | withdrawn
  quorum      String    @default("all") // beim Antrag EINGEFROREN: "all" | "any"
  requestedBy String    @map("requested_by") @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at")
  /// Begründung des Antragstellers; bei kind="revert" Pflicht (Service-Guard).
  reason      String?   @db.Text
  /// Kriterien-Snapshot (GateCriterion[]) zum Antragszeitpunkt — so bleibt
  /// nachvollziehbar, worauf hin freigegeben wurde.
  readiness   Json?
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.Uuid

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  initiative Initiative          @relation(fields: [initiativeId], references: [id])
  approvals  StageGateApproval[]

  // „Höchstens ein offener Antrag pro Epic" ist ein partieller Unique-Index
  // (WHERE status = 'pending') — Prisma kann das nicht ausdrücken, siehe
  // prisma/manual-indexes.sql.
  @@index([tenantId, initiativeId, requestedAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("stage_gate_transitions")
}

/// Eine namentliche Abnahme an einem Gate-Antrag. Der Approver wird beim Antrag
/// aufgelöst und hier EINGEFROREN — dasselbe Snapshot-Muster wie
/// eingefroren, damit spätere Konfig-Änderungen laufende
/// Anträge nicht umdeuten.
model StageGateApproval {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  transitionId   String  @map("transition_id") @db.Uuid
  approverUserId String  @map("approver_user_id") @db.Uuid
  /// Herkunft: "value_stream" | "tenant" | "epic_owner" | "manual"
  source         String  @default("value_stream")
  /// Anzeige-Rolle im Gate-Kontext, ein `GateApproverRole`: die
  /// Wertstrom-Platzhalter (`value_stream.vmo`, `value_stream.finance_approver`),
  /// `epic.owner` oder eine der fünf Business-Case-Parteien
  /// (`epic.party.business_owner` …). null bei direkt benannten Personen.
  role           String?

  status      String    @default("pending") // pending | approved | rejected
  decidedAt   DateTime? @map("decided_at")
  comment     String?   @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at")
  createdBy   String    @map("created_by") @db.Uuid

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  transition StageGateTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

  @@unique([transitionId, approverUserId])
  // Trägt „Meine Freigaben" — der einzige Zugriffspfad des Posteingangs.
  @@index([approverUserId, status])
  @@index([tenantId, transitionId])
  @@map("stage_gate_approvals")
}

/// Konfiguration: WER muss welchen Reifegrad-Wechsel abnehmen.
/// `valueStreamId = null` ist der Tenant-Default; eine Wertstrom-Zeile gewinnt.
/// `required = false` ⇒ dieses Gate braucht keine Abnahme (der Antrag rückt
/// sofort vor — weiterhin ein manueller, auditierter Akt).
///
/// Eigene Tabelle statt Spalten auf `ValueStream`, weil `ValueStream` Core/org
/// gehört und die Gate-Policy Work. `ValueStream.financeApproverId`/`vmoId`
/// werden über die `approverRoles`-Platzhalter weiterhin geehrt.
model StageGateApproverRule {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  valueStreamId String? @map("value_stream_id") @db.Uuid
  toGate        String  @map("to_gate")

  required        Boolean  @default(true)
  quorum          String   @default("all") // "all" | "any"
  approverUserIds String[] @map("approver_user_ids") @db.Uuid
  /// Rollen-Platzhalter, beim Antrag aufgelöst:
  /// "value_stream.finance_approver" | "value_stream.vmo" | "epic.owner"
  approverRoles   String[] @map("approver_roles")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  valueStream ValueStream? @relation(fields: [valueStreamId], references: [id])

  @@unique([tenantId, valueStreamId, toGate])
  @@index([tenantId])
  @@map("stage_gate_approver_rules")
}

model Kpi {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  initiativeId      String   @map("initiative_id") @db.Uuid
  name              String
  unit              String?
  baseline          Decimal? @db.Decimal(14, 2)
  target            Decimal? @db.Decimal(14, 2)
  measurements      Json // [{ date: ISO, value: number }] — time series of actuals
  // Share of the Epic's recurring benefit this KPI realises (fraction 0..1);
  // null = unset → the dashboard splits the benefit equally across the KPIs.
  benefitWeight     Decimal? @map("benefit_weight") @db.Decimal(6, 4)
  /// Finance Controller valuation: € per natural unit of improvement
  /// baseline→target (e.g. € per day saved, € per +1 % NPS).
  valuePerUnit      Decimal? @map("value_per_unit") @db.Decimal(14, 2)
  /// Misst diese KPI den Einmal- oder den wiederkehrenden Benefit?
  /// "one_time" | "recurring" (src/domain/kpi-benefit-kind.ts). Default recurring
  /// = Alt-Verhalten für Bestands-KPIs.
  benefitKind       String   @default("recurring") @map("benefit_kind")
  /// Bei benefitKind="recurring": beschreibt valuePerUnit einen monatlich oder
  /// jährlich wiederkehrenden Mehrwert? "monthly" | "yearly"
  /// (src/domain/kpi-recurring-interval.ts). Default yearly = Alt-Verhalten.
  recurringInterval String   @default("yearly") @map("recurring_interval")
  /// Freitext-Dokumentation der Herleitung (wie kommt man auf die KPI / den Wert).
  calculationNote   String?  @map("calculation_note") @db.Text
  /// Plan-Schnappschuss zur Business-Case-Freigabe (L2 → L3.1):
  /// `{ baseline, target, valuePerUnit, benefitKind, recurringInterval }`.
  /// Der feste Bezugspunkt für Plan-gegen-Ist. Ohne ihn misst sich der Plan an
  /// sich selbst: eine spätere Korrektur von Ziel oder Umrechnungsfaktor
  /// verschöbe beide Seiten gleichzeitig und zeigte nie eine Abweichung.
  /// null = vor Einführung freigegeben ⇒ es gilt der Live-Stand.
  planSnapshot      Json?    @map("plan_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  initiative    Initiative     @relation(fields: [initiativeId], references: [id])
  goalEpicLinks GoalEpicLink[]

  @@index([tenantId, initiativeId])
  @@map("kpis")
}

/// Participatory Budgeting: one row per Epic in the current budgeting round.
/// `allocations` holds the granted amount per half-year period, e.g.
/// { "2026-H1": 120000 }. `hypothesisBudget` is the fixed budget for
/// hypothesis-only Epics (no business-case cost slices). The scheduled start
/// lives on the Epic timeline (timeline.estimates.backlog), not here.
model BudgetAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  epicId           String   @unique @map("epic_id") @db.Uuid
  priority         Int      @default(0)
  hypothesisBudget Decimal? @map("hypothesis_budget") @db.Decimal(14, 2)
  allocations      Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  initiative Initiative @relation(fields: [epicId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("budget_allocations")
}

/// An immutable snapshot of the participatory-budgeting plan for one
/// half-year cycle ("YYYY-H1" | "-H2"). Captures the Epic priorisation,
/// the per-Epic allocations across all occupied half-years, the
/// Value-Stream + ART roll-ups, and the Features that were assigned to
/// PIs within the captured cycle — enough to render the snapshot without
/// touching the live tables. Re-capturing within the same cycle updates
/// the row (idempotent per `(tenantId, cycleKey)`).
model BudgetPlanRevision {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  cycleKey   String   @map("cycle_key") // "YYYY-H1" | "YYYY-H2"
  capturedAt DateTime @default(now()) @map("captured_at")
  capturedBy String   @map("captured_by") @db.Uuid
  // Frozen BudgetPlanSnapshot — see src/domain/budget-plan-snapshot.ts.
  payload    Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cycleKey])
  @@index([tenantId, capturedAt(sort: Desc)])
  @@map("budget_plan_revisions")
}

/// Participatory-Budgeting-Runde je Halbjahres-Cycle: mehrere Gruppen verteilen
/// denselben Topf unabhängig auf dieselben Epics; ausgewertet wird die
/// Übereinstimmung (Drei-Zonen). Status: draft → running → decided → closed.
model BudgetRound {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  cycleKey             String    @map("cycle_key") // "YYYY-H1" | "YYYY-H2" (abgeleitet aus startDate)
  poolTotal            Decimal   @default(0) @map("pool_total") @db.Decimal(14, 2)
  status               String    @default("draft") // draft|running|decided|closed
  scarcityFactor       Decimal?  @map("scarcity_factor") @db.Decimal(8, 4)
  reserveAmount        Decimal?  @map("reserve_amount") @db.Decimal(14, 2)
  decisionAuthorityIds String[]  @map("decision_authority_ids") @db.Uuid
  plannedAt            DateTime? @map("planned_at")
  // Kachel-Modell: Start-Termin der Budgeting-Phase + Ende (Default Start+6 Mon.)
  // + Verteil-Deadline der Gruppen. Nullbar für Alt-Runden (das Kachel-Anlegen
  // setzt sie stets). Identität ist `id`, nicht mehr `(tenantId, cycleKey)` —
  // mehrere/zukünftige Kacheln koexistieren.
  startDate            DateTime? @map("start_date")
  endDate              DateTime? @map("end_date")
  submissionDeadline   DateTime? @map("submission_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  groups       BudgetGroup[]
  allocations  GroupAllocation[]
  decisions    BudgetDecision[]
  participants BudgetParticipant[]
  candidates   BudgetCandidate[]

  @@index([tenantId])
  @@index([tenantId, cycleKey])
  @@map("budget_rounds")
}

/// Eine Teilnehmer-Gruppe einer Runde (≥3, heterogen geschnitten).
model BudgetGroup {
  id             String    @id @default(uuid()) @db.Uuid
  roundId        String    @map("round_id") @db.Uuid
  name           String
  spokespersonId String?   @map("spokesperson_id") @db.Uuid
  // Abgabe-Status der Gruppen-Verteilung (Sprecher reicht ein).
  submittedAt    DateTime? @map("submitted_at")
  submittedBy    String?   @map("submitted_by") @db.Uuid

  round       BudgetRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  members     BudgetGroupMember[]
  allocations GroupAllocation[]
  reportOut   GroupReportOut?

  @@index([roundId])
  @@map("budget_groups")
}

/// Mitglied einer Gruppe. `hasRead` = Pre-Read-Häkchen (C-05).
model BudgetGroupMember {
  id          String  @id @default(uuid()) @db.Uuid
  groupId     String  @map("group_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  team        String?
  isSubmitter Boolean @default(false) @map("is_submitter")
  seniority   String?
  hasRead     Boolean @default(false) @map("has_read")

  group BudgetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@map("budget_group_members")
}

/// €-Vorschlag einer Gruppe je Ballot-Kandidat (Kachel-Modell). Legacy: `epicId`
/// + `funded` (Ja/Nein bis MVP) aus dem alten Drei-Zonen-Flow — nullbar während
/// des Umbaus, fällt im Cutover (Phase 5) weg.
model GroupAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  roundId     String  @map("round_id") @db.Uuid
  groupId     String  @map("group_id") @db.Uuid
  epicId      String? @map("epic_id") @db.Uuid
  candidateId String? @map("candidate_id") @db.Uuid
  amount      Decimal @default(0) @db.Decimal(14, 2)
  funded      Boolean @default(false)
  note        String?

  round      BudgetRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  group      BudgetGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  initiative Initiative?      @relation(fields: [epicId], references: [id], onDelete: Cascade)
  candidate  BudgetCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([groupId, epicId])
  // (groupId, candidateId)-Eindeutigkeit wird im Service erzwungen (kein
  // Prisma-Unique auf der bestehenden Tabelle → additiver, warnungsfreier
  // `prisma db push`).
  @@index([roundId])
  @@index([groupId, candidateId])
  @@map("group_allocations")
}

/// Vereinheitlichter Ballot-Kandidat je Kachel: ein Epic ODER eine
/// Run-the-Business-Position. Beim Start eingefroren. `valueStreamId`/`artId`
/// sind denormalisiert (für die VS-/ART-Ableitung, keine FK). `finalAmount` =
/// Finance-Endbetrag.
model BudgetCandidate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  roundId       String   @map("round_id") @db.Uuid
  kind          String // "epic" | "rtb"
  epicId        String?  @map("epic_id") @db.Uuid
  rtbItemId     String?  @map("rtb_item_id") @db.Uuid
  title         String
  ask           Decimal  @default(0) @db.Decimal(14, 2)
  valueStreamId String?  @map("value_stream_id") @db.Uuid
  artId         String?  @map("art_id") @db.Uuid
  finalAmount   Decimal? @map("final_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  round       BudgetRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  allocations GroupAllocation[]

  @@unique([roundId, epicId])
  @@unique([roundId, rtbItemId])
  @@index([roundId])
  @@index([tenantId])
  @@map("budget_candidates")
}

/// Roster der Beteiligten einer Runde (Schritt 1 vor der Gruppenbildung).
model BudgetParticipant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  roundId  String @map("round_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  round BudgetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([roundId])
  @@map("budget_participants")
}

/// Stehende Run-the-Business-Position eines Value Streams (mehrere je VS), vom
/// VS-Owner gepflegt. `plannedAmount` = Richtwert/Ask (analog Epic.costToMvp).
model RunTheBusinessItem {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  valueStreamId String  @map("value_stream_id") @db.Uuid
  /// Optionale Zurechnung zu einer Solution. `null` = wertstrom-übergreifend
  /// (geteilte Plattform, Programm-Office): zählt in die Wertstrom-Summe, aber
  /// in keine Solution.
  solutionId    String? @map("solution_id") @db.Uuid
  name          String
  plannedAmount Decimal @default(0) @map("planned_amount") @db.Decimal(14, 2)
  /// Periode des Betrags: "monthly" | "half_yearly" | "yearly". Default
  /// `half_yearly`, weil genau das die Bestandszeilen bedeuten — ihr Betrag war
  /// der Ask **einer** Halbjahres-Kachel. Umgerechnet wird ausschließlich in
  /// `domain/rtb-interval.ts`.
  interval      String  @default("half_yearly")
  active        Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  valueStream ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  solution    Solution?   @relation(fields: [solutionId], references: [id], onDelete: SetNull)

  @@index([tenantId, valueStreamId])
  @@index([tenantId, solutionId])
  @@map("run_the_business_items")
}

/// Entscheidung der Instanz je Streuzonen-Epic. Begründung Pflicht bei Abweichung
/// von der Gruppenmehrheit (E-04).
model BudgetDecision {
  id                   String  @id @default(uuid()) @db.Uuid
  roundId              String  @map("round_id") @db.Uuid
  epicId               String  @map("epic_id") @db.Uuid
  outcome              String // funded | rejected | deferred_with_review
  justification        String?
  deferredCheckTask    String? @map("deferred_check_task")
  deviatesFromMajority Boolean @default(false) @map("deviates_from_majority")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  round      BudgetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  initiative Initiative  @relation(fields: [epicId], references: [id], onDelete: Cascade)

  @@unique([roundId, epicId])
  @@index([roundId])
  @@map("budget_decisions")
}

/// Report-out einer Gruppe (E-01): teuerste Zusage / klarstes Nein / größter
/// Streitpunkt, je mit Begründung. Epic-Referenzen als Id (keine FK).
model GroupReportOut {
  id                   String  @id @default(uuid()) @db.Uuid
  groupId              String  @unique @map("group_id") @db.Uuid
  costliestYesEpicId   String? @map("costliest_yes_epic_id") @db.Uuid
  clearestNoEpicId     String? @map("clearest_no_epic_id") @db.Uuid
  biggestDisputeEpicId String? @map("biggest_dispute_epic_id") @db.Uuid
  costliestYesReason   String? @map("costliest_yes_reason")
  clearestNoReason     String? @map("clearest_no_reason")
  disputeReason        String? @map("dispute_reason")

  group BudgetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_report_outs")
}

model Dependency {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fromId    String   @map("from_id") @db.Uuid
  toId      String   @map("to_id") @db.Uuid
  type      String // 'blocks' | 'depends_on' | 'relates_to'
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  from Initiative @relation("From", fields: [fromId], references: [id])
  to   Initiative @relation("To", fields: [toId], references: [id])

  @@unique([fromId, toId, type])
  @@index([tenantId, toId])
  @@index([tenantId, fromId])
  @@map("dependencies")
}

/// Persistierte Netzplan-Layout-Position pro Feature (Initiative auf
/// Feature-Level) im Scope eines Epics. Tenant-weit; alle User sehen
/// dasselbe Layout. Wenn ein Knoten kein Eintrag hat (z. B. neu via
/// Quick-Add), fällt der Client auf dagre-Layout zurück.
model InitiativeGraphPosition {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  epicId       String   @map("epic_id") @db.Uuid
  initiativeId String   @map("initiative_id") @db.Uuid
  x            Float
  y            Float
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String   @map("updated_by") @db.Uuid

  @@unique([epicId, initiativeId])
  @@index([tenantId, epicId])
  @@map("initiative_graph_positions")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actorId      String   @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  changes      Json?
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  traceId      String?  @map("trace_id")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model UserRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  role           String
  valueStreamIds String[] @map("value_stream_ids") @db.Uuid
  artIds         String[] @map("art_ids") @db.Uuid
  teamIds        String[] @map("team_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId, role])
  @@map("user_role_assignments")
}

/// Offener Selbst-Service-Beitritt zu einem Tenant über geteilten Link + Code.
/// Koexistiert mit der gezielten JWT-Einladung (`inviteUser`, Admin → konkrete
/// E-Mail). `autoAccept` = Beitritt sofort wirksam (Assignment als viewer),
/// sonst landet die Anfrage als `TenantJoinRequest` (pending) beim tenant_admin.
/// Pro Tenant existiert höchstens ein aktiver Invite. Kein FK (wie AuditEvent) —
/// tenantId ist ein reines Scalar, damit Tenant-Delete nicht blockiert.
model TenantInvite {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  linkToken  String   @unique @map("link_token")
  joinCode   String   @unique @map("join_code")
  autoAccept Boolean  @default(false) @map("auto_accept")
  active     Boolean  @default(true)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_invites")
}

/// Beitritts-Anfrage über einen offenen Invite. Genehmigt der tenant_admin in
/// `/admin/anfragen` (Platform sieht sie read-only). `userId` ist null, wenn die
/// E-Mail noch kein Konto hat — bei Genehmigung wird dann eine JWT-Einladung
/// versendet statt direkt ein Assignment gesetzt.
model TenantJoinRequest {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String
  userId    String?   @map("user_id") @db.Uuid
  /// "link" | "code" — Herkunft der Anfrage.
  via       String
  /// "pending" | "approved" | "rejected".
  status    String    @default("pending")
  decidedBy String?   @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("tenant_join_requests")
}

/// Öffentlicher Antrag auf einen NEUEN Organisations-Tenant (Self-Service).
/// Genehmigt der platform_admin im „Tenant-Anfragen"-Tab — approve legt via
/// `createOrgTenant` den Tenant an und lädt den Antragsteller als tenant_admin
/// ein. Kein FK (reines Scalar für createdTenantId).
model TenantProvisionRequest {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  desiredName     String    @map("desired_name")
  note            String?
  /// "pending" | "approved" | "rejected".
  status          String    @default("pending")
  decidedBy       String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at")
  createdTenantId String?   @map("created_tenant_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("tenant_provision_requests")
}

/// Pro-Tenant editierbares Mapping Rolle → Capability. Default-Bundle wird
/// aus `POLICIES` in `src/server/auth/policies/index.ts` gespeist (siehe
/// Plan-Datei Capability-Übersicht); jeder Tenant kann delta-editieren
/// (Capability hinzufügen / entziehen / Scope ändern).
///
/// PR A baut nur die Tabelle + den Backfill. `authorize()` arbeitet weiter
/// gegen den Code; PR B macht den Resolver-Switch.
model RoleCapability {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String
  action    String
  /// Optionaler Scope-Override: "value_stream" | "art" | "team" | "own".
  /// null = unscoped. Validierung gegen die `ScopeCheck`-Union erfolgt im
  /// Service-Layer (Zod-Schema), nicht im Schema (Prisma hat keine Enums
  /// hier, um den Aufwand der Migration klein zu halten).
  scope     String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  @@unique([tenantId, role, action])
  @@index([tenantId, role])
  @@map("role_capabilities")
}

// ── Issue module (single type = risk model) ──────────────────────────────────
// One tenant-wide register: probability×impact → exposure/matrix + ROAM + review
// + Feature/Epic linkage (`initiativeId`) + head-issue nesting (`parentId`).
// Replaced the old separate Risk + Impediment tables (dropped at cutover).

model Issue {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  issueNumber          Int?      @map("issue_number") // per-tenant sequential handle
  title                String
  description          String?   @db.Text
  // Single assessment axis: probability×impact → exposure band.
  probability          String? // very_low | low | medium | high | very_high
  impact               String?
  category             String? // technical | business | schedule | external
  reviewStatus         String    @default("documented") @map("review_status") // suggested | documented | rejected
  // Shared ROAM disposition (covers the lifecycle).
  roamStatus           String    @default("open") @map("roam_status")
  roamRationale        String?   @map("roam_rationale") @db.Text
  roamedAt             DateTime? @map("roamed_at")
  roamedBy             String?   @map("roamed_by") @db.Uuid
  // Ownership / provenance.
  ownerId              String?   @map("owner_id") @db.Uuid
  raisedBy             String    @map("raised_by") @db.Uuid
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at")
  targetResolutionDate DateTime? @map("target_resolution_date")
  // Head-issue nesting (self-referential, like Objective) — bundle issues under a head.
  parentId             String?   @map("parent_id") @db.Uuid
  // Scoping: the work item (Feature or Epic) + optional ART/PI context.
  initiativeId         String?   @map("initiative_id") @db.Uuid
  artId                String?   @map("art_id") @db.Uuid
  piId                 String?   @map("pi_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  parent      Issue?            @relation("IssueHierarchy", fields: [parentId], references: [id])
  children    Issue[]           @relation("IssueHierarchy")
  initiative  Initiative?       @relation(fields: [initiativeId], references: [id])
  art         Art?              @relation(fields: [artId], references: [id])
  pi          ProgramIncrement? @relation(fields: [piId], references: [id])
  mitigations IssueMitigation[]
  assessments IssueAssessment[]

  @@unique([tenantId, issueNumber])
  @@index([tenantId, roamStatus])
  @@index([tenantId, ownerId])
  @@index([initiativeId])
  @@index([artId])
  @@index([parentId])
  @@map("issues")
}

model IssueMitigation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, issueId])
  @@map("issue_mitigations")
}

model IssueAssessment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  probability String
  impact      String
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.Uuid

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, issueId])
  @@map("issue_assessments")
}

model IssueSettings {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  prefix     String   @default("R-")
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("issue_settings")
}

/// A named cluster grouping multiple Issues; nestable via `parentClusterId`
/// (Epic-level cluster → Portfolio-level cluster). Membership = `Issue.clusterId`.
model JiraConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  cloudId        String   @map("cloud_id") // Atlassian cloud ID
  instanceUrl    String   @map("instance_url") // https://yoursite.atlassian.net
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")
  // projectKey: JSON map of artId → Jira project key, e.g. {"<artId>": "PROJ"}
  projectKeyMap  Json     @default("{}") @map("project_key_map")
  webhookSecret  String   @map("webhook_secret") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("jira_configs")
}

model AzureDevOpsConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  organization   String // e.g. "my-org"
  accessToken    String   @map("access_token") @db.Text
  refreshToken   String   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime @map("token_expires_at")
  // projectMap: JSON map of artId → "Organization/Project", e.g. {"<artId>": "myorg/MyProject"}
  projectMap     Json     @default("{}") @map("project_map")
  webhookSecret  String   @map("webhook_secret") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("azure_devops_configs")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  status      String    @default("pending") // pending | processed | failed
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   String   @map("response_body") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@map("idempotency_keys")
}
